# ===========================================
# ConvoCard – Environment Variables
# ===========================================

# Arc Testnet RPC
ARC_RPC_URL=https://rpc.testnet.arc.io

# Chain ID (Arc Testnet)
ARC_CHAIN_ID=5042002

# Private key of the wallet that will register the agent
# WARNING: Never commit the real .env file
# Use a dedicated test wallet only
PRIVATE_KEY=0xYourPrivateKeyHere

# Optional: Identity Registry address on Arc Testnet
# (default used in code if not set)
IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e

# Optional: For later IPFS pinning
# PINATA_JWT=
# WEB3_STORAGE_TOKEN=